{
  "name": "o1ocards",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:prod",
    "build:prod": "vite build --mode prod --outDir dist/prod --emptyOutDir",
    "build:preprod": "vite build --mode preprod --outDir dist/preprod --emptyOutDir",
    "build:schema": "node scripts/build-schema.mjs",
    "build:functions": "node scripts/build-functions.mjs",
    "build:all": "npm run build:schema && npm run build:functions && npm run build:prod && npm run build:preprod",
    "deploy:preprod": "node scripts/deploy.mjs preprod",
    "deploy:prod": "node scripts/deploy.mjs prod --yes",
    "test:sql": "bash tests/run-sql.sh",
    "test:functions": "node tests/functions.test.mjs",
    "test:front": "node tests/front.test.mjs",
    "test": "npm run build:all && npm run test:front && npm run test:functions && npm run test:sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.0",
    "vite": "^5.4.0"
  }
}
